# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git.

# --- Discord ---------------------------------------------------------------
DISCORD_TOKEN=PUT_YOUR_DISCORD_BOT_TOKEN_HERE

# --- System Code Scanner (/scan) -------------------------------------------
# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=PUT_YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Directory to scan. Absolute paths recommended.
# Termux/Android example: SCAN_DIRECTORY=/sdcard/MyProject
SCAN_DIRECTORY=/sdcard/MyProject

# Channel that receives the scan report (enable Developer Mode -> Copy Channel ID)
REPORT_CHANNEL_ID=123456789012345678

# Safety limits for one scan
SCAN_MAX_FILE_BYTES=200000
SCAN_MAX_FILES=250

# --- Optional scanner tuning ----------------------------------------------
# Total bytes of source text allowed in one scan
# SCAN_MAX_TOTAL_BYTES=800000
# Bytes of source text per Gemini request (project is chunked above this)
# SCAN_MAX_BYTES_PER_CHUNK=180000
# Maximum number of Gemini requests per scan
# SCAN_MAX_CHUNKS=8
# Per-request Gemini timeout in seconds
# GEMINI_TIMEOUT_SECONDS=180

# --- Optional Roblox ----------------------------------------------
# Reserved for a custom Roblox discovery source returning universe IDs,
# e.g. {"universeIds":[123,456,789]}. Not required by /populargames.
ROBLOX_DISCOVERY_URL=

# --- TikTok Analytics: split architecture ----------------------------------
# TikTok OAuth state, code exchange, token encryption and credential storage
# are owned exclusively by the Xolby web backend (Render).
#
# The Discord bot on Termux talks to that backend over HTTPS and never needs
# TIKTOK_CLIENT_SECRET or the `cryptography` package for TikTok.

# ---- Termux bot (safe to set in the bot's .env) ----
XOLBY_WEB_BASE_URL=https://xolby.onrender.com
XOLBY_WEB_API_KEY=PUT_YOUR_SHARED_INTERNAL_API_KEY_HERE

# Interval in seconds for updating live TikTok analytics messages (default: 300 = 5 minutes)
TIKTOK_LIVE_INTERVAL_SECONDS=300

# ---- Render web backend only (server-side secrets; do NOT set on Termux) ----
# Set these in the Render dashboard environment, not in the bot's .env:
#
# TIKTOK_CLIENT_KEY=PUT_YOUR_TIKTOK_CLIENT_KEY_HERE
# TIKTOK_CLIENT_SECRET=PUT_YOUR_TIKTOK_CLIENT_SECRET_HERE
# TIKTOK_REDIRECT_URI=https://xolby.onrender.com/oauth/tiktok/callback
#
# Encryption secret for tokens stored at rest. Required by the Render backend.
# TIKTOK_TOKEN_ENCRYPTION_KEY=change_this_to_a_secure_random_secret_string
#
# Persistent database (required in production; Render's filesystem is ephemeral).
# Use a PostgreSQL URL, e.g. from Render Postgres or Neon.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
#
# Shared secret the bot uses to authenticate to this backend. Must match the
# bot's XOLBY_WEB_API_KEY above.
# XOLBY_WEB_API_KEY=PUT_YOUR_SHARED_INTERNAL_API_KEY_HERE
#
# Public base URL of this backend (used in docs/links).
# WEB_BASE_URL=https://xolby.onrender.com
# XOLBY_CONTACT_EMAIL=you@example.com
